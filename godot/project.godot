; Engine configuration. Text, diffable, and written by hand or by script — which is the entire
; reason this project is in Godot. See docs/03-tech/adr/0006-move-to-godot.md.

config_version=5

[application]

config/name="Steeplejack"
config/description="A game about climbing tall things and taking them down."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

; The HUD is drawn in fixed pixel sizes for a 1600x900 screen. Scaling the 2D canvas from that base
; keeps it the same size relative to the picture in any window: at 640x360 it had collided with
; itself, and on a 4K screen it would be postage stamps. `expand` keeps every edge anchored rather
; than letterboxing. The window opens at 1280x720, which fits a laptop.
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"

# Shadows. The sun is a soft light and Godot filters its penumbra with a dithered sample pattern,
# so at the default filter quality the terminator is not soft, it is *speckled* — and on a dark
# wool waistcoat, where a stray lit sample is the brightest thing in the garment, that dither is
# the whole surface. It read as mud splatter on his back and as grit on the shaded half of every
# chimney, and it survived turning off GI, reflections, indirect light and the character's own
# normal maps, because none of those were doing it.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/directional_shadow/size=4096
