; The playable scene. Sky, sun, ground, a spawn point and a HUD — the stack itself is generated
; from data/levels/*.json by chimney.gd, because rule 3 says no hand-placed level geometry.
;
; Hand-written text, reviewable in a diff. That is why we are in this engine.

[gd_scene load_steps=16 format=3]

[ext_resource type="Script" path="res://scripts/chimney.gd" id="1_chimney"]
[ext_resource type="Script" path="res://scripts/town.gd" id="5_town"]
[ext_resource type="Script" path="res://scripts/foley.gd" id="6_foley"]
[ext_resource type="Script" path="res://scripts/face.gd" id="7_face"]
[ext_resource type="Script" path="res://scripts/player.gd" id="2_player"]
[ext_resource type="Script" path="res://scripts/hud.gd" id="3_hud"]
[ext_resource type="PackedScene" path="res://assets/characters/steeplejack.glb" id="4_body"]
[ext_resource type="Shader" path="res://shaders/ground.gdshader" id="9_ground"]

[sub_resource type="ProceduralSkyMaterial" id="SkyMat"]
sky_top_color = Color(0.286, 0.376, 0.471, 1)
sky_horizon_color = Color(0.612, 0.624, 0.612, 1)
sky_curve = 0.35
ground_bottom_color = Color(0.157, 0.165, 0.145, 1)
ground_horizon_color = Color(0.404, 0.412, 0.376, 1)
ground_curve = 0.25
sun_angle_max = 24.0
sun_curve = 0.12

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("SkyMat")

[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("Sky")
ambient_light_source = 3
ambient_light_energy = 1.35
tonemap_mode = 3
tonemap_white = 2.6
ssao_enabled = true
ssao_radius = 2.0
ssao_intensity = 1.1
ssil_enabled = true
sdfgi_enabled = false
fog_enabled = true
fog_light_color = Color(0.588, 0.627, 0.647, 1)
fog_light_energy = 0.9
fog_sun_scatter = 0.12
fog_density = 0.0
fog_aerial_perspective = 0.55
fog_sky_affect = 0.45
fog_height = -20.0
fog_height_density = 0.010
fog_depth_enabled = true
fog_depth_begin = 18.0
fog_depth_end = 1400.0
fog_depth_curve = 1.0
adjustment_enabled = true
adjustment_contrast = 1.04
adjustment_saturation = 0.92

[sub_resource type="CapsuleShape3D" id="Capsule"]
radius = 0.34
height = 1.8

[sub_resource type="WorldBoundaryShape3D" id="GroundShape"]

[sub_resource type="ShaderMaterial" id="GroundMat"]
shader = ExtResource("9_ground")

[sub_resource type="PlaneMesh" id="GroundMesh"]
size = Vector2(4000, 4000)
subdivide_width = 8
subdivide_depth = 8

[node name="Steeplejack" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.77, 0.43, -0.47, 0, 0.74, 0.67, 0.64, -0.52, 0.57, 0, 60, 0)
light_energy = 1.5
light_color = Color(1, 0.94, 0.85, 1)
shadow_enabled = true
shadow_opacity = 0.72
light_angular_distance = 1.4
directional_shadow_mode = 2
directional_shadow_split_1 = 0.06
directional_shadow_split_2 = 0.18
directional_shadow_split_3 = 0.45
directional_shadow_blend_splits = true
directional_shadow_max_distance = 320.0

[node name="Ground" type="StaticBody3D" parent="."]

[node name="Mesh" type="MeshInstance3D" parent="Ground"]
mesh = SubResource("GroundMesh")
material_override = SubResource("GroundMat")

[node name="Collision" type="CollisionShape3D" parent="Ground"]
shape = SubResource("GroundShape")

; Every cue in the game, synthesised at load from data/audio/foley.json. No .wav files: they are
; binary, and binary is the half of this project agents cannot author or review.
[node name="Foley" type="Node" parent="."]
script = ExtResource("6_foley")

[node name="Town" type="Node3D" parent="."]
script = ExtResource("5_town")

[node name="Chimney" type="Node3D" parent="."]
script = ExtResource("1_chimney")

; The joints within reach, drawn as what they look like. A sibling of the chimney rather than a
; child, because chimney.gd frees its children whenever it rebuilds the stack.
[node name="Face" type="Node3D" parent="."]
script = ExtResource("7_face")

; Spawned well back. At 30 m a 70 m stack subtends 67 degrees and its top is off the top of the
; screen — the first thing the player sees is being told to climb something they cannot see the end
; of. From 70 m out it fits in frame, and walking in is the establishing shot.
[node name="Player" type="CharacterBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -62, 1, 34)
script = ExtResource("2_player")

[node name="Shape" type="CollisionShape3D" parent="Player"]
shape = SubResource("Capsule")

[node name="Body" parent="Player" instance=ExtResource("4_body")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.9, 0)

[node name="Boom" type="SpringArm3D" parent="Player"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.75, 0)
spring_length = 4.0
margin = 0.3

[node name="Camera" type="Camera3D" parent="Player/Boom"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.65, 0.25, 0)
fov = 72.0

[node name="HUD" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("3_hud")
