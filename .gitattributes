# Text
*.h       text eol=lf
*.cpp     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.txt     text eol=lf
*.replay  text eol=lf

# Binary assets go through Git LFS from the first one.
#
# A binary extension missing from this list is stored raw in the object database, in every clone,
# for ever — and getting it back out means rewriting history. `tools/check_content_size.py` fails
# the build on any binary extension that is not declared here, which is how the character .glb was
# caught sitting outside LFS after the Blender pipeline landed.
*.png     filter=lfs diff=lfs merge=lfs -text
*.tga     filter=lfs diff=lfs merge=lfs -text
*.exr     filter=lfs diff=lfs merge=lfs -text
*.fbx     filter=lfs diff=lfs merge=lfs -text
*.wav     filter=lfs diff=lfs merge=lfs -text
*.ogg     filter=lfs diff=lfs merge=lfs -text

# Models. The steeplejack is built by tools/blender/build_character.py and the .glb is committed
# beside the script that makes it (AGENTS.md, "Adding things").
*.glb     filter=lfs diff=lfs merge=lfs -text
*.blend   filter=lfs diff=lfs merge=lfs -text

# Fonts, and Godot's own binary resource formats.
*.ttf     filter=lfs diff=lfs merge=lfs -text
*.otf     filter=lfs diff=lfs merge=lfs -text
*.res     filter=lfs diff=lfs merge=lfs -text
*.scn     filter=lfs diff=lfs merge=lfs -text
*.ctex    filter=lfs diff=lfs merge=lfs -text
