; Steeplejack — Godot 4 project
; See docs/03-tech/adr/0001-engine-choice.md before changing anything here.

config_version=5

[application]

config/name="Steeplejack"
config/description="A game about climbing tall things and taking them down."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.72, 0.79, 0.83, 1)

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
